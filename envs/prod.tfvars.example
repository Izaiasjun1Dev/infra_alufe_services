# Example configuration for production environment
# Copy this file to prod.tfvars and fill in your actual values

aws_region   = "us-east-1"
project_name = "alufe"
environment  = "prod"

# Twilio credentials (get from https://console.twilio.com)
twilio_account_sid = "YOUR_TWILIO_ACCOUNT_SID"
twilio_auth_token  = "YOUR_TWILIO_AUTH_TOKEN"

# Build configuration
build_image = true
